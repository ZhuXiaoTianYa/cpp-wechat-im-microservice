#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/d/项目/web/node_modules/.pnpm/protobufjs-cli@1.3.0_protobufjs@7.6.0/node_modules/protobufjs-cli/bin/node_modules:/mnt/d/项目/web/node_modules/.pnpm/protobufjs-cli@1.3.0_protobufjs@7.6.0/node_modules/protobufjs-cli/node_modules:/mnt/d/项目/web/node_modules/.pnpm/protobufjs-cli@1.3.0_protobufjs@7.6.0/node_modules:/mnt/d/项目/web/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/d/项目/web/node_modules/.pnpm/protobufjs-cli@1.3.0_protobufjs@7.6.0/node_modules/protobufjs-cli/bin/node_modules:/mnt/d/项目/web/node_modules/.pnpm/protobufjs-cli@1.3.0_protobufjs@7.6.0/node_modules/protobufjs-cli/node_modules:/mnt/d/项目/web/node_modules/.pnpm/protobufjs-cli@1.3.0_protobufjs@7.6.0/node_modules:/mnt/d/项目/web/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/pbts" "$@"
else
  exec node  "$basedir/../../bin/pbts" "$@"
fi
